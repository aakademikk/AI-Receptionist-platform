# =============================================================================
# Atwood Systems — environment
# =============================================================================
# Copy to .env.local (Next.js) and .env (docker compose), then fill in.
# Nothing here has a working default: a missing variable fails loudly at boot
# rather than at 2am (see packages/core/src/env.ts).
#
# NEXT_PUBLIC_* values are compiled into the browser bundle. Everything else is
# server-only, and serverEnv throws if it is read in a browser context.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Locally: run `pnpm db:start`, then copy from `pnpm exec supabase status`. Hosted:
# Project Settings → API.
#
# The variable names below predate Supabase's current key format, so the labels the
# CLI prints do not match them. The mapping:
#
#   supabase status          →  variable here
#   ------------------------    ---------------------------------
#   Project URL              →  NEXT_PUBLIC_SUPABASE_URL
#   Publishable (sb_publishable_…) or "anon key"  →  NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Secret (sb_secret_…) or "service_role key"    →  SUPABASE_SERVICE_ROLE_KEY
#
# The publishable key works in either format. The SERVICE-ROLE key must be the
# LEGACY JWT — `pnpm exec supabase status -o env` prints it as SERVICE_ROLE_KEY.
# supabase-js falls back to sending the API key as an Authorization bearer token when
# there is no user session, which is every service-role request; PostgREST cannot
# verify a non-JWT and answers "No suitable key or wrong key type". The dashboard
# keeps working throughout, because it authenticates with a real user JWT.
#
# Use the *Project URL* — port 54321 locally. Not Studio (54323), not the Storage
# (S3) URL further down that output, and not the dashboard address in your browser;
# all three serve something other than the API, and the app rejects each of them at
# boot with the URL to use instead.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Safe to ship — it identifies the project, it does not grant access. All authority
# comes from the user's JWT and RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Used only by the internal API, the webhook handlers and
# n8n. If this reaches a browser, tenant isolation is gone.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# Absolute URL of the dashboard. Used in magic-link redirects and in the
# conversation links inside notification emails, so it must be the real
# public URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Internal API --------------------------------------------------------------
# Shared secret n8n presents on every internal API call. One value to rotate.
# Generate: openssl rand -base64 48
INTERNAL_API_SECRET=

# --- Credential encryption ----------------------------------------------------
# 32 bytes, base64. Encrypts per-tenant integration credentials at rest, so a
# leaked database dump does not leak a single tenant's Twilio or Google secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
# When rotating, keep the superseded key so envelopes written by it still open:
# CREDENTIAL_ENCRYPTION_KEY_V1=<the old key>

# --- AI providers -------------------------------------------------------------
# Only the providers your tenants actually select need to be set. Each tenant
# picks one in Settings; the adapter layer absorbs the differences between them.
#
# At least one is required before the assistant can reply. If a tenant selects a
# provider whose key is blank, the call fails as a non-retryable ProviderError —
# which workflow 02 turns into a handover rather than a retry loop, so the customer
# reaches a person instead of silence. Correct behaviour, but it is a handover you
# caused, so keep the key set for whatever your tenants have selected.
#
# You do NOT need any of these to browse the dashboard: they are read lazily, at the
# moment a reply is generated.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Twilio -------------------------------------------------------------------
# Platform-level account. TWILIO_AUTH_TOKEN also verifies inbound webhook
# signatures, so it is required even for a receive-only deployment.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The account's other token, during a rotation. Twilio no longer regenerates an auth
# token in place: you request a secondary, move systems onto it, then promote it to
# primary. Both are valid throughout, and a webhook in flight may be signed with
# either -- so set this for the rotation window and clear it afterwards. Webhook
# validation accepts either while both are present.
TWILIO_AUTH_TOKEN_SECONDARY=
# Only needed behind a tunnel or proxy that does not forward the original host.
# Twilio signs the exact URL configured in its console, so validation has to rebuild
# that URL — and a quick tunnel rewrites Host to the origin, leaving the app
# reconstructing http://localhost:3000/... and rejecting every request as a bad
# signature. Set the public base and the scheme and host come from here instead:
#   TWILIO_WEBHOOK_BASE_URL=https://<subdomain>.trycloudflare.com
TWILIO_WEBHOOK_BASE_URL=
# Optional. A Messaging Service handles sender pools and sticky sender; without
# one, messages are sent from the tenant's explicit number.
TWILIO_MESSAGING_SERVICE_SID=

# DEVELOPMENT ONLY. Accept inbound webhooks without verifying their signature.
#
# Signature verification is the only thing between the inbound endpoint and anyone who
# learns its URL: without it a stranger can post a forged customer message and bill the
# tenant for the AI reply. Set this only on a local machine, and only when signatures
# cannot be made to verify — it exists so that the alternative (commenting the check
# out, which is the same hole with none of the warnings and a real chance of being
# committed) is never the easier path.
#
# Only the exact string "true" is honoured, and a production build refuses to start a
# webhook with it set rather than quietly ignoring it. Every accepted request is logged
# at warn.
# TWILIO_SKIP_SIGNATURE_CHECK=true

# --- Onboarding ---------------------------------------------------------------
# Firecrawl scrapes a new tenant's website to draft their profile. Optional: without
# it the onboarding job fails, and a tenant profile has to be filled in by hand (or
# by SQL). Nothing on the live conversation path touches it.
FIRECRAWL_API_KEY=

# --- Notifications ------------------------------------------------------------
# Optional, and it degrades quietly: with RESEND_API_KEY blank, an email
# notification is raised as `not_configured` and the worker suppresses the row
# instead of retrying it forever. Handovers still appear in the dashboard queue —
# you just will not be emailed about them, which for a product whose whole promise
# is "you will not miss a lead" is worth setting up before you have real tenants.
RESEND_API_KEY=
# Must be on a domain you have verified with Resend, or every send is rejected.
NOTIFICATION_FROM_EMAIL=notifications@yourdomain.com

# --- n8n ----------------------------------------------------------------------
# Where the webhook handlers hand off to.
#
# Blank is the deliberate default: the handlers then call the internal API directly
# and the platform is fully functional without the orchestrator. Pointing this at an
# n8n that is not running is worse than leaving it blank — every missed call tries
# the hand-off, gets a connection refused, and the follow-up SMS never sends.
#
# Set it to http://localhost:5678 once `pnpm n8n:up` is running and the workflows
# are imported and activated.
N8N_WEBHOOK_BASE_URL=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info

# =============================================================================
# docker compose only — not read by the app
# =============================================================================
# Left blank on purpose. compose declares these with `:?`, so an unset value stops
# the stack with a named error — which is strictly better than a working default,
# because "change-me-in-production" is a string that reaches production.
# Generate: openssl rand -base64 36
POSTGRES_PASSWORD=

# Losing this makes every credential stored inside n8n unreadable. Back it up
# somewhere other than the machine running n8n.
# Generate: openssl rand -base64 48
N8N_ENCRYPTION_KEY=

# There is no N8N_BASIC_AUTH_* here on purpose — current n8n ignores those
# variables, so setting them would suggest the editor is protected when it is not.
# Access is controlled by n8n's own owner account, and compose binds the editor to
# 127.0.0.1. Claim the owner account the first time you open http://localhost:5678:
# whoever loads it first gets it, and an n8n owner can read the service-role key.

# Absolute URL n8n uses when registering webhooks with itself.
N8N_WEBHOOK_URL=http://localhost:5678
# Reachable from inside the n8n container. On Docker Desktop use
# http://host.docker.internal:3000; on Linux, the compose service name.
ATWOOD_API_URL=http://host.docker.internal:3000
