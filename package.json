{
  "name": "atwood-systems",
  "private": true,
  "version": "0.1.0",
  "description": "Atwood Systems \u2014 white-label AI receptionist platform for missed calls, SMS and WhatsApp.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @atwood/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "env:check": "node --experimental-strip-types scripts/check-env.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > packages/core/src/types/database.ts",
    "n8n:up": "docker compose up -d n8n",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,sql}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "supabase": "^2.110.0",
    "typescript": "^5.7.2"
  }
}
